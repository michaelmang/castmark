# Postgres connection string (Neon via Vercel, or any Postgres instance)
DATABASE_URL=""

# Random secret used to sign the session cookie — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Stripe (test mode keys while developing — dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
# The recurring Price ID for the subscription plan (starts with "price_")
STRIPE_PRICE_ID=""
# Signing secret for the webhook endpoint, from the webhook's settings page
# once it's registered (starts with "whsec_")
STRIPE_WEBHOOK_SECRET=""

# Resend (resend.com/api-keys) — used to send password reset emails
RESEND_API_KEY=""
# Verified sender address, e.g. "Castmark <noreply@yourdomain.com>".
# Defaults to Resend's onboarding@resend.dev sandbox sender if unset.
EMAIL_FROM=""
