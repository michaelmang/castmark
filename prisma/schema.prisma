generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// subscriptionStatus mirrors Stripe subscription statuses:
// "trialing" | "active" | "past_due" | "canceled" | "incomplete" | null (no subscription yet)
model Account {
  id                   String    @id @default(cuid())
  slug                 String    @unique
  showName             String
  email                String    @unique
  passwordHash         String
  createdAt            DateTime  @default(now())
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  subscriptionStatus   String?
  trialEndsAt          DateTime?

  sponsors            Sponsor[]
  links               Link[]
  episodes            Episode[]
  linkEpisodes        LinkEpisode[]
  clicks              Click[]
  passwordResetTokens PasswordResetToken[]
}

// tokenHash: SHA-256 hash of the raw token emailed to the user — only the
// hash is stored, mirroring how passwords themselves are never stored raw.
model PasswordResetToken {
  id        String    @id @default(cuid())
  accountId String
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([accountId])
}

// status: "active" | "paused" | "expired"
model Sponsor {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name      String
  logoUrl   String?
  status    String   @default("active")
  createdAt DateTime @default(now())
  links     Link[]
}

// fallbackUrl: optional override shown instead of the generic expired page
// when the link is paused/expired/out of its date window
model Link {
  id             String        @id @default(cuid())
  accountId      String
  account        Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  sponsorId      String
  sponsor        Sponsor       @relation(fields: [sponsorId], references: [id], onDelete: Cascade)
  slug           String
  destinationUrl String
  discountCode   String?
  startDate      DateTime?
  endDate        DateTime?
  fallbackUrl    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  episodes       LinkEpisode[]
  clicks         Click[]

  @@unique([accountId, slug])
}

model Episode {
  id          String        @id @default(cuid())
  accountId   String
  account     Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  title       String
  publishDate DateTime?
  createdAt   DateTime      @default(now())
  links       LinkEpisode[]
  clicks      Click[]

  @@unique([accountId, title])
}

// slug: episode-specific redirect slug (e.g. "acme-ep42") so clicks from
// that episode's show notes can be told apart from the base link's clicks
model LinkEpisode {
  linkId    String
  episodeId String
  accountId String
  slug      String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  link      Link    @relation(fields: [linkId], references: [id], onDelete: Cascade)
  episode   Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@id([linkId, episodeId])
  @@unique([accountId, slug])
}

// deviceType: "desktop" | "mobile" | "tablet" | "other"
model Click {
  id           String   @id @default(cuid())
  accountId    String
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  linkId       String
  link         Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)
  episodeId    String?
  episode      Episode? @relation(fields: [episodeId], references: [id], onDelete: SetNull)
  timestamp    DateTime @default(now())
  referrer     String?
  deviceType   String?
  country      String?
  userAgentRaw String?

  @@index([accountId, timestamp])
  @@index([linkId, timestamp])
  @@index([episodeId, timestamp])
}
